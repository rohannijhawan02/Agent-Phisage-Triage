OPENROUTER_API_KEY=
# Per-1K-token prices in USD, used to estimate cost telemetry.
# Set these to your model's actual input/output rates (leave 0 to disable).
COST_PER_1K_INPUT=0
COST_PER_1K_OUTPUT=0
# Variance-reduction knobs. Neither guarantees determinism on hosted APIs;
# they only reduce run-to-run drift.
# Fixed sampling seed (on by default). Set to "off" to omit the seed.
LLM_SEED=0
# Optional: pin routing to a single OpenRouter provider (e.g. "Anthropic").
# Leave empty for default routing.
OPENROUTER_PROVIDER=
# Production agentic graph model. If omitted, it writes review-only reports.
TRIAGE_MODEL=
# OpenAI-compatible hosted endpoint and key; OpenRouter remains the fallback.
TRIAGE_LLM_URL=
TRIAGE_LLM_API_KEY=
